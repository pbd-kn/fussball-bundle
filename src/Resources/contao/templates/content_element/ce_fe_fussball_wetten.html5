<div class="tabellenueberschrift">
    Wetten der <?= htmlspecialchars((string) ($this->wettbewerb), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
    vom <?= htmlspecialchars((string) ($this->datumStart), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
    bis <?= htmlspecialchars((string) ($this->datumEnde), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
</div>

<table class="tablecss" rules="all" border="1">
    <thead>
        <tr>
            <th>Kommentar</th>
            <th>Pok</th>
            <th>Ptrend</th>
            <th>Art</th>
            <th>Tipp1</th>
            <th>Tipp2</th>
            <th>Tipp3</th>
            <th>Tipp4</th>
        </tr>
    </thead>

    <tbody>
        <?php foreach ($this->wetten as $item): ?>
            <?php $w = $item['row']; ?>
            <?php $d = $item['details']; ?>

            <tr>
                <td><?= htmlspecialchars((string) ($w['Kommentar']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($w['Pok']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($w['Ptrend']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($w['Art']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>

                <?php if ($w['Art'] === 's'): ?>
                    <td>
                        <img src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($d['Flagge1'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" />
                        <?= htmlspecialchars((string) ($d['M1Name']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?> :
                        <img src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($d['Flagge2'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" />
                        <?= htmlspecialchars((string) ($d['M2Name']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                    </td>
                    <td><?= htmlspecialchars((string) ($w['Tipp2']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                    <td><?= htmlspecialchars((string) ($w['Tipp3']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                    <td><?= htmlspecialchars((string) ($w['Tipp4']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>

                <?php else: ?>
                    <td><?= htmlspecialchars((string) ($w['Tipp1']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                    <td><?= htmlspecialchars((string) ($w['Tipp2']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                    <td><?= htmlspecialchars((string) ($w['Tipp3']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                    <td><?= htmlspecialchars((string) ($w['Tipp4']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <?php endif; ?>
            </tr>
        <?php endforeach; ?>
    </tbody>
</table>
