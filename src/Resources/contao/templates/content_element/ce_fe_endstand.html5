<?php
/**
 * Frontend-Template: Endstand
 * FINAL – stabil, mit korrekt integriertem PUV-Block
 */

if (!isset($this->data)) {
    echo '<p><b>DEBUG:</b> $this->data ist nicht gesetzt</p>';
    return;
}
?>


<script>
function toggleSection(h){
  h.classList.toggle('closed');
  h.nextElementSibling.classList.toggle('hidden');
}
function toggleDebug(el){
  const d = el.nextElementSibling;
  d.style.display = d.style.display==='block'?'none':'block';
}
</script>

<?php /* ================= RANGLISTE ================= */ ?>
<?php if (!empty($this->data['rangliste'])): ?>
<div class="rangliste-wrapper">
<section class="endstand-section">
<h2 onclick="toggleSection(this)">🏆 Rangliste</h2>
<div class="toggle-body">

<table class="rangliste-table">
<thead>
<tr>
  <th>Reihenfolge</th>
  <th>Name</th>
  <th>Punkte</th>
</tr>
</thead>
<tbody>
<?php $i=1; foreach ($this->data['rangliste'] as $r): ?>
<tr>
  <td><?= htmlspecialchars((string) ($i++), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
  <td><?= htmlspecialchars($r['Name']) ?></td>
  <td><?= htmlspecialchars((string) ((int)$r['Punkte']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
</tr>
<?php endforeach; ?>
</tbody>
</table>

<div onclick="toggleDebug(this)" style="cursor:pointer;">▶ DEBUG Rangliste</div>
<div class="debug-box"><pre><?php print_r($this->data['rangliste']); ?></pre></div>

</div>
</section>
</div>
<?php endif; ?>

<?php /* ================= SECTIONS ================= */ ?>
<?php foreach (($this->data['sections'] ?? []) as $section): ?>

<section class="endstand-section">
<h2 class="closed" onclick="toggleSection(this)">
    <?= htmlspecialchars($section['title']) ?>
</h2>
<div class="toggle-body hidden">

<?php /* ===== SPIELE ===== */ ?>
<?php if ($section['type']==='spiele'): ?>
<?php foreach ($section['rows'] as $row): ?>
<div class="player-row">
<div class="player-name"><?= htmlspecialchars($row['name']) ?></div>

<div class="cards-scroll">
    <?php foreach ($row['cards'] as $card): ?>
        <div class="card">
            <div><b><?= htmlspecialchars($card['datum']) ?></b></div>
            <div>
                <img class="flag" src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($card['flag1'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>">
                <?= htmlspecialchars($card['m1']) ?>
                <?= htmlspecialchars((string) ($card['t1']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?> : <?= htmlspecialchars((string) ($card['t2']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                <?= htmlspecialchars($card['m2']) ?>
                <img class="flag" src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($card['flag2'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>">
            </div>
            <hr>
            <div>gewettet: <?= htmlspecialchars($card['wette']) ?></div>
            <div>Punkte: <?= htmlspecialchars((string) ((int)$card['punkte']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></div>
        </div>
    <?php endforeach; ?>
</div>

<div class="player-sum"><?= htmlspecialchars((string) ($row['sum']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></div>
</div>
<?php endforeach; ?>

<?php /* ===== GRUPPEN ===== */ ?>
<?php elseif ($section['type']==='gruppen'): ?>
    <?php foreach ($section['rows'] as $row): ?>
        <div class="player-row">
            <div class="player-name"><?= htmlspecialchars($row['name']) ?>

            </div>

            <div class="cards-scroll">
                <?php foreach ($row['cards'] as $card): ?>
                    <div class="card">
                        <div><b>Gruppe <?= htmlspecialchars($card['gruppe']) ?></b></div>
                        <div>gewettet:</div>
                        <div>1: <?= htmlspecialchars($card['tipp1'] ?? '-') ?>
                        <img class="flag" src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($card['tippFlag1'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>">
                        </div>
                        <div>2: <?= htmlspecialchars($card['tipp2'] ?? ' — ') ?>  <img class="flag" src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($card['tippFlag2'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>"> </div>
                        <div><hr>Ist:</div>
                        <div>1: <?= htmlspecialchars($card['ist1'] ?? '&nbsp;—&nbsp;') ?>  <img class="flag" src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($card['istFlag1'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>"> </div>
                        <div>2: <?= htmlspecialchars($card['ist2'] ?? ' — ') ?>  <img class="flag" src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($card['istFlag2'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>"> </div>
                        <div>Punkte: <?= htmlspecialchars((string) ((int)$card['punkte']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></div>
                    </div>
                <?php endforeach; ?>
            </div>

            <div class="player-sum"><?= htmlspecialchars((string) ($row['sum']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></div>
        </div>
    <?php endforeach; ?>

<?php /* ===== PLATZ & VERGLEICH (PUV) ===== */ ?>
<?php elseif ($section['type']==='puv'): ?>

    <?php if (!empty($section['rows'])): ?>
        <?php foreach ($section['rows'] as $row): ?>
            <div class="player-row">
                <div class="player-name"><?= htmlspecialchars($row['name']) ?></div>

                <div class="cards-scroll">
                    <?php foreach ($row['cards'] as $card): ?>
                        <div class="card">
                        <?php
                            //echo "Windex: " . $card['wetteId'] . "<br>";
                            echo htmlspecialchars((string) $card['kommentar'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . "(".(int) $card['tipp1'].")<br>";
                            if (!empty($card['mpnation'])) {
                                echo "<div>" . htmlspecialchars($card['mpnation']) . " <img class='flag' src='" . $this->fussballUtil->getImagePath($card['mpflagge']) . "'><br></div>";
                            } else {
                                echo (int) $card['tipp1']."<br>";
                            }
                            echo "<hr>";
                            echo "gewettet: " . htmlspecialchars((string) $card['gewettet'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . "<br>";
                            echo "Punkte: "  . (int) $card['punkte'] . "<br>";
                        ?>
                        </div>
                    <?php endforeach; ?>
                </div>

            <div class="player-sum"><?= htmlspecialchars((string) ($row['sum']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></div>
        </div>
    <?php endforeach; ?>
<?php else: ?>
<p style="font-style:italic;">Keine Platz-/Vergleich-Wetten vorhanden</p>
<?php endif; ?>

<?php if (!empty($section['infotext'])): ?>
<div style="margin-top:0.5rem;font-size:0.85rem;white-space:pre-line;">
INFO Deutschland wird<br>
<?= htmlspecialchars($section['infotext']) ?>
</div>
<?php endif; ?>

<?php endif; ?>

<div onclick="toggleDebug(this)" style="cursor:pointer;">▶ DEBUG Section</div>
<div class="debug-box"><pre><?php print_r($section); ?></pre></div>

</div>
</section>
<?php endforeach; ?>
