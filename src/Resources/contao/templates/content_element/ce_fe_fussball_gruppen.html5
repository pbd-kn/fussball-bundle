<div class="tabellenueberschrift">
    Gruppenplan der <?= htmlspecialchars((string) ($this->wettbewerb), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
    vom <?= htmlspecialchars((string) ($this->datumStart), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
    bis <?= htmlspecialchars((string) ($this->datumEnde), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
</div>

<table class="tablecss sortierbar" rules="all" border="1">
    <thead>
        <tr>
            <th class="vorsortiert">Gr</th>
            <th>M</th>
            <th>Pl</th>
            <th>Sp</th>
            <th>G</th>
            <th>U</th>
            <th>N</th>
            <th>T</th>
            <th>GT</th>
            <th>Di</th>
            <th>Pkt</th>
        </tr>
    </thead>

    <tbody>

    <?php foreach ($this->gruppenListen as $gruppen): ?>
        <?php foreach ($gruppen as $row): ?>

            <tr>
                <td><?= htmlspecialchars((string) ($row['Gruppe']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>

                <td>
                    <img src="<?= htmlspecialchars((string) ($this->fussballUtil->getImagePath($row['Flagge1'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" />
                    <?= htmlspecialchars((string) ($row['M1Name']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                </td>

                <td><?= htmlspecialchars((string) ($row['Platz']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($row['Spiele']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($row['Sieg']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($row['Unentschieden']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($row['Niederlage']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($row['Tore']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($row['Gegentore']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($row['Differenz']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                <td><?= htmlspecialchars((string) ($row['Punkte']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
            </tr>

        <?php endforeach; ?>
    <?php endforeach; ?>

    </tbody>
</table>
