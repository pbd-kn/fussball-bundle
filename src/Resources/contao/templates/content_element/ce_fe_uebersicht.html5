<?php
/**
 * Template: ce_fe_uebersicht.html5
 * Spielplan + Gruppentabellen
 * Daten kommen vollständig korrekt aus dem Controller
 */

/* ======================================================
   HELPER: Flaggenpfad
====================================================== */
$flagUrl = function (?string $file): string
{
    return htmlspecialchars($this->fussballUtil->getImagePath((string) $file), ENT_QUOTES, 'UTF-8');
};

/* ======================================================
   GRUPPENTABELLEN nach Gruppe aufteilen
====================================================== */
$gruppenInfo = [];

foreach ($this->Gruppen as $row) {
    $gruppenInfo[$row['Gruppe']][] = $row;
}

/* ======================================================
   SPIELE nach Kategorien + Gruppen aufteilen
====================================================== */
$getKategorie = static function (string $gruppe): int
{
    $g = strtolower($gruppe);

    if (preg_match('/^[a-z]$/', $g)) return 1;          // Gruppenphase
    if (str_starts_with($g, 'sechz')) return 2;
    if (str_starts_with($g, 'achtel')) return 3;
    if (str_starts_with($g, 'viertel')) return 4;
    if (str_starts_with($g, 'halb')) return 5;
    if (str_starts_with($g, 'platz')) return 6;
    if (str_starts_with($g, 'finale')) return 7;

    return 99;
};

$kategorien = [
    1 => [], 2 => [], 3 => [], 4 => [],
    5 => [], 6 => [], 7 => [], 99 => [],
];

foreach ($this->Spiele as $spiel) {
    $kat = $getKategorie($spiel['Gruppe']);
    $kategorien[$kat][$spiel['Gruppe']][] = $spiel;
}

/* ======================================================
   KATEGORIE-TITEL
====================================================== */
$katTitel = [
    1 => 'Gruppenphase',
    2 => 'Sechzehntelfinale',
    3 => 'Achtelfinale',
    4 => 'Viertelfinale',
    5 => 'Halbfinale',
    6 => 'Spiel um Platz 3',
    7 => 'Finale',
    99 => 'Weitere Spiele',
];
?>

<!-- ======================================================
     AUSGABE
====================================================== -->

<div class="tabellenueberschrift">
    Spielplan der <?= htmlspecialchars((string) ($this->Wettbewerb), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
    vom <?= htmlspecialchars((string) ($this->start), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?> bis <?= htmlspecialchars((string) ($this->ende), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
</div>

<?php foreach ($kategorien as $kat => $gruppen): ?>
    <?php if (empty($gruppen)) continue; ?>

    <div class="kategorie-row">

        <div class="kategorie-titel">
            <?= htmlspecialchars((string) ($katTitel[$kat]), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
        </div>

        <div class="kategorie-scroll">

            <?php foreach ($gruppen as $gruppenName => $spiele): ?>

                <div class="gruppe">

                    <div class="gruppen-titel">
                        <?= htmlspecialchars((string) ($gruppenName), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                    </div>

                    <!-- =============================
                         GRUPPENTABELLE (nur Gruppenphase)
                    ============================== -->
                    <?php if ($kat === 1 && isset($gruppenInfo[$gruppenName])): ?>
                        <table class="gruppen-tabelle">
                            <tr>
                                <th>Pl.</th>
                                <th>Team</th>
                                <th>Sp.</th>
                                <th>Pkt.</th>
                                <th>Tore</th>
                                <th>Diff</th>
                            </tr>
                            <?php foreach ($gruppenInfo[$gruppenName] as $team): ?>
                                <tr>
                                    <td><?= htmlspecialchars((string) ($team['Platz']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                                    <td class="team-cell">
                                        <img src="<?= htmlspecialchars((string) ($flagUrl($team['Flagge1'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" class="flag-small">
                                        <?= htmlspecialchars((string) ($team['M1Name']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                                    </td>
                                    <td><?= htmlspecialchars((string) ($team['Spiele']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                                    <td><?= htmlspecialchars((string) ($team['Punkte']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                                    <td><?= htmlspecialchars((string) ($team['Tore']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>:<?= htmlspecialchars((string) ($team['Gegentore']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                                    <td><?= htmlspecialchars((string) ($team['Differenz']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></td>
                                </tr>
                            <?php endforeach; ?>
                        </table>
                    <?php endif; ?>

                    <!-- =============================
                         SPIELE
                    ============================== -->
                    <?php foreach ($spiele as $sp): ?>
                        <div class="spiel-box">

                            <div class="sp-nr">
                                Spiel <?= htmlspecialchars((string) ($sp['Nr']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                            </div>

                            <div class="sp-kopf">
                                <?= htmlspecialchars((string) ($sp['Ort']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                                &nbsp;<?= htmlspecialchars((string) ($sp['Datum']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                                &nbsp;<?= htmlspecialchars((string) ($sp['Uhrzeit']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                            </div>

                            <div class="team">
                                <div class="team-name">
                                    <img src="<?= htmlspecialchars((string) ($flagUrl($sp['Flagge1'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" class="flag">
                                    <?= htmlspecialchars((string) ($sp['M1Name']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                                </div>
                                <div class="team-score"><?= htmlspecialchars((string) ($sp['T1']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></div>
                            </div>

                            <div class="team">
                                <div class="team-name">
                                    <img src="<?= htmlspecialchars((string) ($flagUrl($sp['Flagge2'])), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>" class="flag">
                                    <?= htmlspecialchars((string) ($sp['M2Name']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?>
                                </div>
                                <div class="team-score"><?= htmlspecialchars((string) ($sp['T2']), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') ?></div>
                            </div>

                        </div>
                    <?php endforeach; ?>

                </div>

            <?php endforeach; ?>

        </div>

    </div>

<?php endforeach; ?>
