		"contao/core-bundle": "^4.13 || ^5.7",
		"symfony/framework-bundle": "^5.4 || ^6.4 || ^7.4",
		"symfony/routing": "^5.4 || ^6.4 || ^7.4",
		"doctrine/dbal": "^2.13 || ^3.0 || ^4.0"
	},
	"conflict": {
			"contao/manager-plugin": "<2.0 || >=3.0",
			"symfony/symfony": "3.2.7"
