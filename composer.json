{
	"name":"pbd-kn/fussball-bundle",
	"description":"Bearbeitet das Fussball wetten Modell",
	"type":"contao-bundle",
	"license":"LGPL-3.0-or-later",
	"authors":[
		{
			"name":"Peter Broghammer",
			"email":"pb-contao@gmx.de",
			"role":"Developer"
		}
	],
	"support":{
